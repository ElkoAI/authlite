# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# PHP files
[*.php]
indent_size = 4
max_line_length = 120

# JavaScript files
[*.js]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# CSS files
[*.css]
indent_size = 2

# HTML files
[*.html]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = 80

# Shell scripts
[*.sh]
indent_size = 2
shell = bash

# Makefiles
[Makefile]
indent_style = tab

# Configuration files
[*.yml]
[*.yaml]
indent_size = 2

# INI files
[*.ini]
indent_size = 2

# Git files
[.gitattributes]
[.gitignore]
indent_size = 2

# Composer files
[composer.json]
[composer.lock]
indent_size = 2

# Batch files use tabs
[*.bat]
end_of_line = crlf
